{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
  "setupFiles": ["<rootDir>/test/utils/load-env.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1
}
