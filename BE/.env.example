# ————— App —————
NODE_ENV=development
PORT=3001
# Danh sách origin của FE, phân tách bằng dấu phẩy.
# Khi deploy Cloudflare Pages nhớ thêm domain chính + *.pages.dev + domain preview.
CORS_ORIGIN=http://localhost:3000

# ————— PostgreSQL (chạy local, không dùng Docker) —————
# Tạo role + db một lần:
#   psql -U <user-cua-ban> -d postgres -c "CREATE ROLE spendly LOGIN PASSWORD 'spendly'"
#   psql -U <user-cua-ban> -d postgres -c "CREATE DATABASE spendly OWNER spendly"
DB_HOST=localhost
DB_PORT=5432
DB_USER=spendly
DB_PASSWORD=spendly
DB_NAME=spendly

# TLS cho Postgres. Để trống hoặc `false` khi dùng Postgres local.
# ⚠️ Bật nhầm khi đang trỏ localhost: bản Postgres của Ubuntu/Debian CÓ phục vụ TLS nhưng
#    bằng chứng chỉ tự ký, nên app chết với `Error: self-signed certificate` — câu lỗi đó
#    không nhắc gì tới DB_SSL, rất dễ đi tìm sai chỗ. Nhớ đổi DB_HOST cùng lúc.
#
# Đặt `true` khi dùng Postgres quản lý (Neon, Supabase, Railway…) vì họ CHỈ nhận TLS.
# Ví dụ với Neon — lấy từ connection string trong console:
#   DB_HOST=ep-xxxx-pooler.ap-southeast-1.aws.neon.tech
#   DB_USER=<neon-user>
#   DB_PASSWORD=<neon-password>
#   DB_NAME=neondb
#   DB_SSL=true
#
# ⚠️ Chỉ nhận đúng chuỗi `true` mới là bật. Mọi giá trị khác đều coi như tắt.
# ⚠️ Neon cho 2 host: bản thường và bản `-pooler`. App dùng `-pooler`; khi chạy
#    `migration:run` thì tạm đổi sang host TRỰC TIẾP — pooler chạy chế độ transaction
#    của PgBouncer, hay gãy với những thao tác cần trạng thái ở mức phiên.
DB_SSL=false

# ————— Redis (chạy local) —————
REDIS_HOST=localhost
REDIS_PORT=6379

# ————— Auth —————
# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=<sinh-bang-openssl-rand-base64-48>
JWT_REFRESH_SECRET=<sinh-chuoi-KHAC-voi-access>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ————— AI (giao thức OpenAI-compatible) —————
# Đổi nhà cung cấp chỉ cần sửa 3 biến dưới, KHÔNG phải sửa code.
#
#   Gemini (khuyến nghị — tiếng Việt tốt nhất, có free tier):
#     lấy key tại https://aistudio.google.com/apikey
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-flash-lite-latest
#
#     Dùng bản LITE chứ không phải `gemini-flash-latest`: mọi phép tính đã làm ở BE,
#     model chỉ cần diễn giải số liệu thành câu — không cần suy luận sâu. Đo thực tế
#     trên cùng prompt báo cáo: lite 3 giây, bản thường 79 giây, chất lượng như nhau.
#     Dùng bí danh `-latest` để không chết khi Google gỡ model cũ.
#
#   Groq (nhanh nhất, free tier rộng, tiếng Việt yếu hơn):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   xAI Grok (cần nạp credit, không còn free tier cho team mới):
#     LLM_BASE_URL=https://api.x.ai/v1
#     LLM_MODEL=grok-3
#
# Để trống LLM_API_KEY thì app vẫn chạy, chỉ là tính năng AI báo "chưa sẵn sàng".
LLM_PROVIDER=Gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest

# Giới hạn số lượt gọi AI mỗi ngày cho mỗi user (đếm bằng Redis)
AI_DAILY_LIMIT=30

# ————————————————————— Cloudinary —————————————————————
# Nơi lưu ẢNH QR CHUYỂN TIỀN của người trong danh bạ.
#
# FE upload thẳng lên Cloudinary bằng chữ ký do BE cấp (GET /uploads/signature), nên
# API_SECRET không bao giờ rời khỏi máy chủ — đừng đưa nó sang FE.
#
# Lấy ở https://console.cloudinary.com → Dashboard (Product Environment Credentials).
# Để TRỐNG cả ba thì app vẫn chạy bình thường, chỉ riêng phần lưu ảnh QR báo 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
