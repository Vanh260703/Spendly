# ————— App —————
NODE_ENV=development
PORT=3001
# Origin của FE, phân tách bằng dấu phẩy nếu có nhiều
CORS_ORIGIN=http://localhost:3000

# ————— PostgreSQL —————
#
# Chạy bằng Docker (`docker compose up -d --build`, xem docker-compose.yml ở repo root):
# service `be` tự GHI ĐÈ DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME/PORT/CORS_ORIGIN qua
# khối `environment:` — 6 dòng dưới đây KHÔNG có tác dụng trong trường hợp đó.
#
# Chạy `npm run start:dev` NGOÀI Docker thì các dòng dưới MỚI thật sự được dùng, và cần
# Postgres cài sẵn trên máy. Tạo role + db một lần:
#   sudo -u postgres psql -c "CREATE ROLE spendly LOGIN PASSWORD 'spendly'"
#   sudo -u postgres psql -c "CREATE DATABASE spendly OWNER spendly"
DB_HOST=localhost
DB_PORT=5432
DB_USER=spendly
DB_PASSWORD=spendly
DB_NAME=spendly

# ————— AI (giao thức OpenAI-compatible) —————
# Đổi nhà cung cấp chỉ cần sửa 3 biến dưới, KHÔNG phải sửa code.
#
#   Gemini (khuyến nghị — tiếng Việt tốt nhất, có free tier):
#     lấy key tại https://aistudio.google.com/apikey
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-flash-lite-latest
#
# Để trống LLM_API_KEY thì app vẫn chạy, chỉ là tính năng AI báo "chưa sẵn sàng".
#
# ⚠️ Cố ý KHÔNG có giới hạn lượt gọi/ngày kiểu đếm tự động (bản trước dùng Redis cho việc
# này). Cơ chế chặn gọi trùng THẬT SỰ nằm ở Postgres — `ai_insights` khóa theo hash dữ liệu
# đầu vào, dữ liệu chưa đổi thì không gọi lại LLM dù có đếm lượt hay không. Tự canh quota
# qua trang quản trị của nhà cung cấp (VD aistudio.google.com) nếu cần.
LLM_PROVIDER=Gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest

# ————— Tài khoản ngân hàng (bắt buộc — app chặn boot nếu thiếu) —————
# ⚠️ Phải khớp CHÍNH XÁC accountNumber mà SePay gửi kèm giao dịch. Sai thì giao dịch về
# không tra ra chủ, vẫn bị bỏ qua (nhưng vẫn được ghi vào sepay_webhook_logs).
BANK_ACCOUNT_NUMBER=
BANK_NAME=Ngân hàng

# ————— Chu kỳ thời gian —————
TIMEZONE=Asia/Ho_Chi_Minh
# Ngày bắt đầu chu kỳ "tháng" (1–28), VD 25 = tháng chạy từ 25 tới 24 tháng sau
MONTH_START_DAY=1
# Thu nhập hàng tháng ước tính (đồng) — để trống thì AI vẫn chạy, chỉ bỏ qua phần quy đổi %
MONTHLY_INCOME=

# ————— SePay API (kéo giao dịch — nguồn dữ liệu DUY NHẤT, không còn webhook) —————
# Để trống SEPAY_API_TOKEN thì app vẫn chạy, chỉ là không đồng bộ được — hợp lý khi
# dựng thử trên máy khác.
#
# Lấy token: my.sepay.vn → Cấu hình Công ty → API Access
# ⚠️ Token này TOÀN QUYỀN — SePay chưa hỗ trợ phân quyền cho API, ai cầm được token là đọc
# được mọi giao dịch của tài khoản ngân hàng đã liên kết. Không commit, không đưa sang FE.
SEPAY_API_URL=https://my.sepay.vn
SEPAY_API_TOKEN=
