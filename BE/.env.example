# ————— App —————
NODE_ENV=development
PORT=3001
# Danh sách origin của FE, phân tách bằng dấu phẩy.
# Khi deploy Cloudflare Pages nhớ thêm domain chính + *.pages.dev + domain preview.
CORS_ORIGIN=http://localhost:3000

# ————— PostgreSQL (chạy local, không dùng Docker) —————
# Tạo role + db một lần:
#   psql -U <user-cua-ban> -d postgres -c "CREATE ROLE spendly LOGIN PASSWORD 'spendly'"
#   psql -U <user-cua-ban> -d postgres -c "CREATE DATABASE spendly OWNER spendly"
DB_HOST=localhost
DB_PORT=5432
DB_USER=spendly
DB_PASSWORD=spendly
DB_NAME=spendly

# ————— Redis (chạy local) —————
REDIS_HOST=localhost
REDIS_PORT=6379

# ————— Auth —————
# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=<sinh-bang-openssl-rand-base64-48>
JWT_REFRESH_SECRET=<sinh-chuoi-KHAC-voi-access>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ————— AI (giao thức OpenAI-compatible) —————
# Đổi nhà cung cấp chỉ cần sửa 3 biến dưới, KHÔNG phải sửa code.
#
#   Gemini (khuyến nghị — tiếng Việt tốt nhất, có free tier):
#     lấy key tại https://aistudio.google.com/apikey
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-flash-lite-latest
#
#     Dùng bản LITE chứ không phải `gemini-flash-latest`: mọi phép tính đã làm ở BE,
#     model chỉ cần diễn giải số liệu thành câu — không cần suy luận sâu. Đo thực tế
#     trên cùng prompt báo cáo: lite 3 giây, bản thường 79 giây, chất lượng như nhau.
#     Dùng bí danh `-latest` để không chết khi Google gỡ model cũ.
#
#   Groq (nhanh nhất, free tier rộng, tiếng Việt yếu hơn):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   xAI Grok (cần nạp credit, không còn free tier cho team mới):
#     LLM_BASE_URL=https://api.x.ai/v1
#     LLM_MODEL=grok-3
#
# Để trống LLM_API_KEY thì app vẫn chạy, chỉ là tính năng AI báo "chưa sẵn sàng".
LLM_PROVIDER=Gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest

# Giới hạn số lượt gọi AI mỗi ngày cho mỗi user (đếm bằng Redis)
AI_DAILY_LIMIT=30
